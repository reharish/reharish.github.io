---
// BlogPreview.astro
// Lists blog articles in a directory/terminal interface style on the homepage.
const posts = Object.values(import.meta.glob('../content/blog/*.md', { eager: true })) as any[];

// Sort posts by date descending
const sortedPosts = posts.sort((a, b) => {
  return new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime();
});
---

<section id="blog" class="py-24 px-4 max-w-6xl mx-auto border-b border-border-muted bg-background">
  <div class="space-y-12">
    <!-- Header -->
    <div class="flex items-center space-x-4">
      <h2 class="text-3xl sm:text-4xl font-bold font-mono text-text-primary flex items-center gap-2">
        <span class="text-accent">05.</span> Engineering Notes
      </h2>
      <div class="h-[1px] bg-border-muted flex-grow"></div>
    </div>

    <!-- Blog Folder List -->
    <div class="bg-surface border border-border-muted rounded-md overflow-hidden font-mono">
      <!-- Folder Header -->
      <div class="bg-background px-4 py-3 border-b border-border-muted text-xs sm:text-sm text-text-secondary flex justify-between items-center">
        <span>DIRECTORY: /var/www/blog/posts</span>
        <span>{sortedPosts.length} File(s)</span>
      </div>

      <!-- File Listing -->
      <div class="divide-y divide-border-muted/50 text-sm sm:text-base">
        {sortedPosts.map((post) => {
          const slug = post.file.split('/').pop().replace('.md', '');
          const formattedDate = new Date(post.frontmatter.pubDate).toLocaleDateString('en-US', {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit'
          });
          
          return (
            <a href={`/blog/${slug}`} class="block p-5 sm:p-6 hover:bg-accent/5 group transition-colors">
              <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                
                <!-- Title & Status -->
                <div class="space-y-1.5">
                  <div class="flex items-center space-x-3">
                    <span class="text-success text-xs sm:text-sm font-bold">-rwxr-xr-x</span>
                    <h3 class="text-base sm:text-lg font-bold text-text-primary group-hover:text-accent transition-colors">
                      {post.frontmatter.title}.md
                    </h3>
                  </div>
                  <p class="text-sm text-text-secondary font-sans leading-relaxed pl-0 md:pl-20">
                    {post.frontmatter.description}
                  </p>
                </div>

                <!-- Date & Tags -->
                <div class="flex items-center space-x-4 self-start md:self-auto text-xs sm:text-sm text-text-secondary whitespace-nowrap pl-0 md:pl-0">
                  <div class="hidden sm:flex gap-2">
                    {post.frontmatter.tags.slice(0, 2).map((tag: string) => (
                      <span class="px-2 py-0.5 border border-border-muted rounded text-[10px] sm:text-xs text-text-secondary bg-background/50">
                        {tag}
                      </span>
                    ))}
                  </div>
                  <time datetime={post.frontmatter.pubDate} class="text-text-secondary font-mono">
                    {formattedDate}
                  </time>
                </div>

              </div>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</section>
