---
// Contact.astro
// Clean, SSH config style footer contact links.
---

<footer id="contact" class="py-20 px-4 max-w-6xl mx-auto font-mono text-sm sm:text-base">
  <div class="border-t border-border-muted pt-12 flex flex-col md:flex-row md:justify-between items-start md:items-center gap-8">
    <!-- SSH configuration layout -->
    <div class="space-y-2 bg-surface/50 border border-border-muted/50 p-5 rounded-md w-full max-w-lg">
      <div class="text-text-secondary font-bold uppercase tracking-wider text-xs mb-3">// SSH CONNECTION CONFIG</div>
      
      <p class="text-text-primary text-base sm:text-lg"><span class="text-accent font-bold">Host</span> reharish.github.io</p>
      <div class="pl-4 space-y-2 text-text-secondary text-sm sm:text-base">
        <p>
          <span class="text-text-primary">Github</span> 
          <a href="https://github.com/reharish" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline ml-6">github.com/reharish</a>
        </p>
        <p>
          <span class="text-text-primary">LinkedIn</span> 
          <a href="https://www.linkedin.com/in/harishbaburengaraj" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline ml-4">linkedin.com/in/harishbaburengaraj</a>
        </p>
        <p>
          <span class="text-text-primary">Email</span> 
          <a href="mailto:rengarajharish@gmail.com" class="text-accent hover:underline ml-7">rengarajharish@gmail.com</a>
        </p>
      </div>
    </div>

    <!-- Copyright and stats info -->
    <div class="space-y-2 text-text-secondary md:text-right w-full md:w-auto text-xs sm:text-sm">
      <p class="text-[11px] sm:text-xs uppercase tracking-widest text-accent font-bold">// SYSTEM REPORT</p>
      <p>Connection: SECURE (TLS_AES_256_GCM_SHA384)</p>
      <p>© 2026 Harishbabu Rengaraj. Made in Chennai.</p>
    </div>
  </div>
</footer>
