---
// TerminalHero.astro
// Retro-cyberpunk interactive terminal hero section.
---

<section class="min-h-[calc(100vh-4rem)] flex flex-col justify-center items-center relative overflow-hidden py-16 px-4 border-b border-border-muted bg-background">

  <div class="max-w-6xl w-full mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center z-10">
    <!-- Hero Text Information (7 Columns) -->
    <div class="lg:col-span-6 flex flex-col space-y-6">
      <div class="inline-flex items-center space-x-2 text-xs md:text-sm font-mono text-success bg-success/10 px-3 py-1 rounded-full border border-success/20 self-start">
        <span class="w-1.5 h-1.5 rounded-full bg-success animate-ping"></span>
        <span>STATUS: ACTIVE & EXPLORING</span>
      </div>

      <div class="space-y-3">
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold font-mono tracking-tight text-text-primary leading-none">
          Harishbabu Rengaraj<span class="text-accent animate-pulse">_</span>
        </h1>
        <p class="text-base sm:text-lg md:text-xl font-mono text-accent font-medium">
          Automation Engineer // Embedded Enthusiast // Linux Explorer
        </p>
      </div>

      <!-- Rotating Terminal Status Text -->
      <div class="h-8 flex items-center font-mono text-sm sm:text-base text-success/90">
        <span class="mr-2 text-text-secondary">&gt; </span>
        <span id="rotating-status-text" class="border-r-2 border-success pr-1 font-bold"></span>
      </div>

      <p class="text-text-secondary text-base sm:text-lg max-w-xl leading-relaxed">
        I build systems, automate repetitive work, and spend an unreasonable amount of time understanding how technology works beneath the surface.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap gap-4 pt-2">
        <a href="#projects" class="px-6 py-3.5 bg-accent text-background font-mono font-bold text-sm rounded shadow-[0_0_15px_rgba(88,166,255,0.3)] hover:shadow-[0_0_25px_rgba(88,166,255,0.6)] hover:bg-white hover:text-black transition-all">
          Explore Projects
        </a>
        <a href="https://drive.google.com/file/d/15O9qdnNNVXtIXLJEpobCccmXRFZ5pQdb/view" target="_blank" rel="noopener noreferrer" class="px-6 py-3.5 border border-border-muted hover:border-success hover:text-success font-mono text-sm rounded transition-all flex items-center gap-2 bg-surface/30">
          <span>View Resume</span>
          <span class="text-[10px] text-text-secondary bg-surface px-1.5 py-0.5 rounded border border-border-muted">PDF</span>
        </a>
        <a href="https://github.com/reharish" target="_blank" rel="noopener noreferrer" class="px-6 py-3.5 border border-border-muted hover:border-accent hover:text-accent font-mono text-sm rounded transition-all bg-surface/30">
          GitHub
        </a>
      </div>

      <!-- Credentials Badges Section -->
      <div class="space-y-3 pt-4 border-t border-border-muted/50">
        <div class="text-[11px] font-mono text-text-secondary uppercase tracking-widest">// Cybersecurity Credentials</div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-xl">
          <!-- HackTheBox Badge -->
          <a href="https://www.hackthebox.com/profile/330996" target="_blank" rel="noopener noreferrer" class="block border border-border-muted bg-surface/30 hover:border-success p-2.5 rounded transition-all">
            <div class="flex items-center gap-3">
              <img src="http://www.hackthebox.eu/badge/image/330996" alt="Hack The Box Profile" class="h-8" />
              <div class="font-mono text-left">
                <div class="text-[9px] text-text-secondary uppercase">HackTheBox</div>
                <div class="text-xs text-text-primary font-bold">Profile #330996</div>
              </div>
            </div>
          </a>

          <!-- TryHackMe Badge -->
          <a href="https://tryhackme.com/p/whitedot" target="_blank" rel="noopener noreferrer" class="block border border-border-muted bg-surface/30 hover:border-accent p-2.5 rounded transition-all">
            <div class="flex items-center gap-3">
              <img src="https://tryhackme-badges.s3.amazonaws.com/whitedot.png" alt="TryHackMe Profile" class="h-8" />
              <div class="font-mono text-left">
                <div class="text-[9px] text-text-secondary uppercase">TryHackMe</div>
                <div class="text-xs text-text-primary font-bold">whitedot</div>
              </div>
            </div>
          </a>
        </div>
      </div>
    </div>

    <!-- Retro Interactive Terminal Monitor (6 Columns) -->
    <div class="lg:col-span-6 w-full text-left">
      <div class="bg-[#161B22] border border-[#30363D] rounded-lg shadow-2xl overflow-hidden scanlines">
        <!-- Terminal Header -->
        <div class="bg-[#0D1117]/90 px-4 py-3 flex items-center justify-between border-b border-[#30363D] text-xs font-mono text-[#8B949E]">
          <div class="flex items-center space-x-2">
            <span class="w-3 h-3 rounded-full bg-red-500/30"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500/30"></span>
            <span class="w-3 h-3 rounded-full bg-green-500/30"></span>
          </div>
          <span>harish@reharish.github.io: ~</span>
          <span class="text-[10px] text-[#58A6FF]">tty1</span>
        </div>
        <!-- Terminal Output - Increased Height & Text size (Hardcoded Dark background) -->
        <div class="p-4 h-[440px] overflow-y-auto font-mono text-xs leading-relaxed text-[#8B949E] space-y-1.5 bg-[#0D1117]/50 selection:bg-[#58A6FF]/40 selection:text-white" id="boot-terminal-log">
          <!-- Logs will be dynamically appended here -->
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Typewriter status rotation
  const initStatusRotator = () => {
    const statuses = [
      "Debugging something.",
      "Reading datasheets.",
      "Breaking things.",
      "Fixing things.",
      "Learning protocols.",
      "Asking \"why?\""
    ];
    const target = document.getElementById('rotating-status-text');
    if (!target) return;

    let index = 0;
    let charIndex = 0;
    let isDeleting = false;
    let delay = 150;

    const type = () => {
      const current = statuses[index];
      
      if (isDeleting) {
        target.textContent = current.substring(0, charIndex - 1);
        charIndex--;
        delay = 50;
      } else {
        target.textContent = current.substring(0, charIndex + 1);
        charIndex++;
        delay = 120;
      }

      if (!isDeleting && charIndex === current.length) {
        isDeleting = true;
        delay = 1800;
      } else if (isDeleting && charIndex === 0) {
        isDeleting = false;
        index = (index + 1) % statuses.length;
        delay = 400;
      }

      setTimeout(type, delay);
    };

    type();
  };

  // Simulated system boot logs
  const initBootLogs = () => {
    const logContainer = document.getElementById('boot-terminal-log');
    if (!logContainer) return;

    const logs = [
      { text: "[    0.000000] Booting Linux on physical CPU 0x0", type: "info" },
      { text: "[    0.005128] Machine model: Harish Devboard v2.1", type: "info" },
      { text: "[    0.012891] Memory: 16GB System RAM (ECC disabled)", type: "info" },
      { text: "[    0.031902] ACPI: Core revision 20260602", type: "info" },
      { text: "[    0.098492] CPU0: Spectre v2 mitigation: Mitigation: LFENCE", type: "info" },
      { text: "[    0.149204] usbcore: registered new interface driver hub", type: "info" },
      { text: "[    0.183491] zilogic_parrot: loading framework modules... OK", type: "success" },
      { text: "[    0.201499] robot_serial: probing device... found PySerial node", type: "success" },
      { text: "[    0.245892] i2c_designware: Synopsys DesignWare I2C adapter", type: "info" },
      { text: "[    0.298491] lemon_ate: Android backdoors verification: SUCCESS", type: "success" },
      { text: "[    0.345891] android_pwn: ADB interface bindings established", type: "success" },
      { text: "[    0.412499] net_automation: Selenium WebDriver: listening on port 4444", type: "info" },
      { text: "[    0.485902] autom_validate: testing CAN bus transceiver... OK", type: "success" },
      { text: "[    0.501294] autom_validate: testing USB-C PD contract (20V/5A)... OK", type: "success" },
      { text: "[    0.542891] pipewire: server active, core audio channels linked", type: "info" },
      { text: "[    0.598491] homelab: local Kubernetes node active & healthy", type: "success" },
      { text: "[    0.621499] systemd[1]: Started Harish Portfolio Engine (reharish.github.io).", type: "success" },
      { text: "[    0.638491] status_daemon: state changed to: READY_FOR_QUERIES", type: "accent" }
    ];

    let logIndex = 0;

    const printNextLog = () => {
      if (logIndex >= logs.length) {
        setTimeout(() => {
          if (logContainer) {
            const separator = document.createElement('div');
            separator.className = 'border-b border-[#30363D]/30 my-2';
            logContainer.appendChild(separator);
          }
          logIndex = 0;
          printNextLog();
        }, 15000);
        return;
      }

      const log = logs[logIndex];
      const div = document.createElement('div');
      
      if (log.type === "success") {
        div.className = "text-[#39D353]";
      } else if (log.type === "accent") {
        div.className = "text-[#58A6FF] font-bold";
      } else {
        div.className = "text-[#8B949E]";
      }

      div.textContent = log.text;
      logContainer.appendChild(div);
      logContainer.scrollTop = logContainer.scrollHeight;

      logIndex++;
      
      const baseDelay = 120;
      const randomDelay = Math.random() * 150;
      const finalDelay = log.type === "success" ? baseDelay + randomDelay + 100 : baseDelay + randomDelay;
      
      setTimeout(printNextLog, finalDelay);
    };

    printNextLog();
  };

  // Run on load
  initStatusRotator();
  initBootLogs();
</script>
